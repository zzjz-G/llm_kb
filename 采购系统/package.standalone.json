    "@radix-ui/react-tooltip": "^1.2.8",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.3",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "antd": "^5.24.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
