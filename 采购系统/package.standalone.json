{
  "name": "lab-purchase-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "课题组耗材采购与库存管理系统（独立部署版）",
  "scripts": {
    "dev": "concurrently -k -n tsc,server,client -c gray,blue,green \"npm run dev:tsc\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:tsc": "tsc -p tsconfig.standalone.json --watch --preserveWatchOutput",
    "dev:server": "node --watch-path=dist/server --watch-path=dist/shared dist/server/bootstrap.js",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.standalone.json && tsc-alias -p tsconfig.standalone.json",
    "build:client": "vite build --config vite.config.ts",
    "start": "NODE_ENV=production node dist/server/bootstrap.js",
    "db:migrate": "node server/database/migrate.js",
    "type:check": "tsc --noEmit --project tsconfig.standalone.json"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/serve-static": "^4.0.2",
    "@tanstack/react-query": "^5.90.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.15",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.45.2",
    "hbs": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^5.0.0",
    "react-router-dom": "^7.4.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
