# 数据库连接
DATABASE_URL=postgresql://username:password@localhost:5432/lab_inventory?schema=public

# 服务端
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=production

# JWT 密钥（生产环境务必修改为强随机字符串）
JWT_SECRET=change_this_to_a_strong_random_secret_key

# CORS 配置（逗号分隔的多个源，留空表示允许所有）
CORS_ORIGIN=

# 请求体大小限制
BODY_LIMIT=10mb

# 前端路径前缀（部署在子路径下时配置，如 /lab-inventory）
CLIENT_BASE_PATH=/

# 开发模式专用
# NODE_ENV=development
